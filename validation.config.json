{
  "ignore": [
    "version-lab/snapshots",
    "artifacts"
  ],
  "requireVersionInIndex": true,
  "jsonSchemas": [
    {
      "file": "data/schools.json",
      "path": [
        "schools"
      ],
      "type": "array",
      "minItems": 1
    },
    {
      "file": "data/primary-schools.json",
      "path": [
        "schools"
      ],
      "type": "array",
      "minItems": 1
    },
    {
      "file": "data/performance.json",
      "path": [
        "schools"
      ],
      "type": "array",
      "minItems": 1
    },
    {
      "file": "data/assessments.json",
      "path": [
        "schools"
      ],
      "type": "object",
      "minKeys": 1
    },
    {
      "file": "data/assessment-resources.json",
      "path": [
        "resources"
      ],
      "type": "array",
      "minItems": 1
    }
  ],
  "pages": [
    {
      "path": "/",
      "readySelector": "#list .card",
      "minCount": 1,
      "assertions": [
        {
          "type": "count",
          "selector": "#list .card",
          "min": 1
        }
      ]
    },
    {
      "path": "/performance.html",
      "readySelector": ".school-row",
      "minCount": 1,
      "assertions": [
        {
          "type": "count",
          "selector": ".school-row",
          "min": 1
        }
      ]
    },
    {
      "path": "/assessments.html",
      "readySelector": "#schoolRows tr",
      "minCount": 1,
      "assertions": [
        {
          "type": "count",
          "selector": "#schoolRows tr",
          "min": 1
        },
        {
          "type": "count",
          "selector": "#resourceGrid .resource-card",
          "min": 1
        }
      ]
    }
  ],
  "releaseGate": {
    "enabled": true,
    "scenarioModule": "validation/openday-release-gate.mjs",
    "path": "/",
    "readySelector": "#list .card",
    "allowExternalNetwork": false,
    "maxExternalRequests": 14,
    "quietMs": 400,
    "timeoutMs": 3000,
    "maxStateTransitions": 2,
    "failOnPageErrors": true,
    "maxLocalRequests": 80,
    "maxLocalBytes": 5000000,
    "maxFirebaseReads": 0,
    "maxFirebaseWrites": 0,
    "maxFirebaseDeletes": 0,
    "maxFirebaseListeners": 0
  },
  "ignoreLocalRequestFailures": [
    "/Kk-syllabus/"
  ]
}
