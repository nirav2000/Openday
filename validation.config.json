{
  "ignore": [
    "version-lab/snapshots",
    "artifacts"
  ],
  "requireVersionInIndex": true,
  "jsonSchemas": [
    {
      "file": "data/schools.json",
      "path": [
        "schools"
      ],
      "type": "array",
      "minItems": 1
    },
    {
      "file": "data/primary-schools.json",
      "path": [
        "schools"
      ],
      "type": "array",
      "minItems": 1
    },
    {
      "file": "data/performance.json",
      "path": [
        "schools"
      ],
      "type": "array",
      "minItems": 1
    },
    {
      "file": "data/assessments.json",
      "path": [
        "schools"
      ],
      "type": "object",
      "minKeys": 1
    },
    {
      "file": "data/assessment-resources.json",
      "path": [
        "resources"
      ],
      "type": "array",
      "minItems": 1
    },
    {
      "file": "data/scholarships.json",
      "path": [
        "schools"
      ],
      "type": "array",
      "minItems": 1
    },
    {
      "file": "data/school-questions.json",
      "path": [
        "questions"
      ],
      "type": "array",
      "minItems": 1
    },
    {
      "file": "data/primary-performance.json",
      "path": [
        "schools"
      ],
      "type": "object",
      "minKeys": 1
    },
    {
      "file": "data/primary-cohort-context.json",
      "path": [
        "schools"
      ],
      "type": "object",
      "minKeys": 0
    }
  ],
  "pages": [
    {
      "path": "/",
      "readySelector": "#list .card",
      "minCount": 1,
      "assertions": [
        {
          "type": "count",
          "selector": "#list .card",
          "min": 1
        }
      ]
    },
    {
      "path": "/performance.html",
      "readySelector": ".school-row",
      "minCount": 1,
      "assertions": [
        {
          "type": "count",
          "selector": ".school-row",
          "min": 1
        }
      ]
    },
    {
      "path": "/measures.html",
      "readySelector": "#a8Total",
      "minCount": 1,
      "assertions": [
        {
          "type": "count",
          "selector": "#gradesGrid select",
          "min": 17
        },
        {
          "type": "text",
          "selector": "#a8Total",
          "contains": "81"
        }
      ]
    },
    {
      "path": "/assessments.html",
      "readySelector": "#schoolRows tr",
      "minCount": 1,
      "assertions": [
        {
          "type": "count",
          "selector": "#schoolRows tr",
          "min": 1
        },
        {
          "type": "count",
          "selector": "#resourceGrid .resource-card",
          "min": 1
        }
      ]
    },
    {
      "path": "/scholarships.html",
      "readySelector": "#list .card",
      "minCount": 1,
      "assertions": [
        {
          "type": "count",
          "selector": "#list .card",
          "min": 1
        }
      ]
    },
    {
      "path": "/questions.html",
      "readySelector": "#list .card",
      "minCount": 1,
      "assertions": [
        {
          "type": "count",
          "selector": "#list .card",
          "min": 1
        }
      ]
    },
    {
      "path": "/primary-performance.html?school=Pinner%20Wood%20School",
      "readySelector": "#detail .result-grid",
      "minCount": 1,
      "assertions": [
        {
          "type": "text",
          "selector": "#detail h2",
          "contains": "Pinner Wood"
        },
        {
          "type": "count",
          "selector": "#detail .result-card",
          "min": 2
        }
      ]
    }
  ],
  "releaseGate": {
    "enabled": true,
    "scenarioModule": "validation/openday-release-gate.mjs",
    "path": "/",
    "readySelector": "#list .card",
    "allowExternalNetwork": false,
    "maxExternalRequests": 18,
    "quietMs": 400,
    "timeoutMs": 3000,
    "maxStateTransitions": 2,
    "failOnPageErrors": true,
    "maxLocalRequests": 80,
    "maxLocalBytes": 5000000,
    "maxFirebaseReads": 0,
    "maxFirebaseWrites": 0,
    "maxFirebaseDeletes": 0,
    "maxFirebaseListeners": 0
  },
  "ignoreLocalRequestFailures": [
    "/Kk-syllabus/"
  ],
  "codeQuality": {
    "version": "2.0.0",
    "sharedCommit": "5c63f05cce303b9f268f06cbb0b9cec69dab5b97",
    "include": [
      "primary-performance.js"
    ],
    "nodeFiles": []
  },
  "interactionTests": {
    "version": "2.0.0",
    "sharedCommit": "5c63f05cce303b9f268f06cbb0b9cec69dab5b97",
    "profiles": [
      {
        "name": "desktop",
        "width": 1365,
        "height": 900
      },
      {
        "name": "mobile-touch",
        "width": 390,
        "height": 844,
        "touch": true
      }
    ],
    "scenarios": [
      {
        "name": "primary-deeplink-and-search",
        "path": "/primary-performance.html?school=Pinner%20Wood%20School",
        "steps": [
          {
            "action": "visible",
            "selector": "#detail .result-grid"
          },
          {
            "action": "text",
            "selector": "#detail h2",
            "contains": "Pinner Wood"
          },
          {
            "action": "focus",
            "selector": "#search"
          },
          {
            "action": "value",
            "selector": "#search",
            "value": ""
          },
          {
            "action": "fill",
            "selector": "#search",
            "value": "Park Lane Primary School"
          },
          {
            "action": "count",
            "selector": "#rows button",
            "min": 1
          },
          {
            "action": "click",
            "selector": "#rows tr:first-child button"
          },
          {
            "action": "visible",
            "selector": "#detail .result-grid"
          },
          {
            "action": "url",
            "param": "school",
            "value": "Park Lane Primary School"
          },
          {
            "action": "text",
            "selector": "#detail h2",
            "contains": "Park Lane"
          },
          {
            "action": "click",
            "selector": "#clearSearch"
          },
          {
            "action": "value",
            "selector": "#search",
            "value": ""
          }
        ]
      },
      {
        "name": "primary-year-switch",
        "path": "/primary-performance.html?school=Pinner%20Wood%20School",
        "steps": [
          {
            "action": "visible",
            "selector": "#detail .result-grid"
          },
          {
            "action": "select",
            "selector": "#year-picker",
            "value": "2023/24"
          },
          {
            "action": "text",
            "selector": "#detail .detail-meta",
            "contains": "2023/24"
          },
          {
            "action": "visible",
            "selector": "#detail .result-card"
          }
        ]
      },
      {
        "name": "secondary-performance-load",
        "path": "/performance.html",
        "steps": [
          {
            "action": "visible",
            "selector": ".school-row"
          }
        ]
      },
      {
        "name": "home-and-assessments",
        "path": "/",
        "steps": [
          {
            "action": "visible",
            "selector": "#list .card"
          }
        ]
      }
    ]
  }
}
